# dependencies
node_modules/

# build output
.next/
public/widget.js
public/widget/

# ingest artefacts — regenerated by `npm run ingest`
data/

# secrets
.env
.env*.local

# a scraped copy of the client's own homepage, used to test the widget against
# their real CSS. Never deploy it: served from chat.skayle360.com it would
# duplicate their site on their own subdomain. Regenerate with
# `npm run dev:mirror`.
public/mirror/

# misc
*.log
.DS_Store

# typescript incremental build cache
tsconfig.tsbuildinfo

# Client documents. They belong in the knowledge base, not in source control —
# upload them through the admin page, which stores the file itself.
*.pdf
*.docx
*.pptx
