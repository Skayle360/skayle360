# ---- required ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...

# ---- retrieval (optional; without one, retrieval runs lexical-only) ----
VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---- escalation email ----
# PENDING: DNS for the sending domain. Until notify.skayle360.com is verified,
# leave ESCALATION_LIVE unset and point ESCALATION_TEST_INBOX at your own inbox.
RESEND_API_KEY=
ESCALATION_TEST_INBOX=you@example.com
# ESCALATION_LIVE=true
# MAIL_FROM=SCALE UP Assistant <assistant@notify.skayle360.com>

# ---- overrides (all have verified defaults; change only with a reason) ----
# BOOKING_URL=https://calendly.com/chrisciunci/scale-up-discussion
# CONTACT_EMAIL=cciunci@skayle360.com
# ALLOWED_ORIGINS=https://skayle360.com,https://skayle360.webflow.io
# SITE_URL=https://skayle360.com

# ---- lead mirror (confirmed: Google Sheet) ----
# Postgres stays the source of truth; the Sheet is a mirror.
# Service account needs Editor access on the Sheet.
ENABLE_SHEETS_MIRROR=true
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEET_LEAD_TAB=Leads
# GOOGLE_SHEET_ESCALATION_TAB=Unanswered

# ---- client-editable knowledge (requirement 5) ----
# A Google Doc the client edits himself. Share it with the service account
# above as Viewer, and enable the Google Docs API in the same project.
# Read on the weekly cron, so his edits reach the bot without a deploy.
KNOWLEDGE_DOC_ID=

# ---- admin page (internal tool) ----
# ADMIN_SECRET must be at least 24 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SECRET=
